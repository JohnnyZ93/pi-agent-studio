{
  "name": "pi-agent-studio",
  "displayName": "Pi Agent Studio",
  "version": "1.1.2",
  "description": "Feature-rich Pi coding agent for VS Code - native terminal TUI or webview chat panel, full editor bridge, and bundled pi extensions (todo, subagent...) out of the box, plus a sidebar to manage sessions, models, agents, and settings.",
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "agent",
    "ai",
    "ai-assistant",
    "anthropic",
    "chat",
    "claude",
    "coding-agent",
    "gemini",
    "llm",
    "openai",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "terminal",
    "tui"
  ],
  "bugs": {
    "url": "https://github.com/JohnnyZ93/pi-agent-studio/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnnyZ93/pi-agent-studio"
  },
  "publisher": "johnny-zhao",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts -w",
    "package": "pnpm build && pnpx @vscode/vsce package --no-dependencies",
    "install-local": "pnpm package && code --install-extension *.vsix",
    "release": "node scripts/release.ts",
    "fmt": "oxlint . --fix && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "tsgo --noEmit --skipLibCheck",
    "test": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.110.0",
    "@typescript/native-preview": "^7.0.0-dev.20260320.1",
    "@vscode/vsce": "^3.7.1",
    "jsdom": "^30.0.1",
    "ovsx": "^0.10.9",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "rolldown": "^1.0.0-rc.10",
    "vitest": "^4.1.0"
  },
  "contributes": {
    "icons": {
      "pi-logo": {
        "description": "Pi logo icon",
        "default": {
          "fontPath": "assets/fonts/pi-icons.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "commands": [
      {
        "command": "pi-agent-studio.open",
        "title": "Pi: Open",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-agent-studio.upgrade",
        "title": "Pi: Upgrade Pi"
      },
      {
        "command": "pi-agent-studio.openSettingsJson",
        "title": "Pi: Open settings.json"
      },
      {
        "command": "pi-agent-studio.openModelsJson",
        "title": "Pi: Open models.json"
      },
      {
        "command": "pi-agent-studio.openInNewWindow",
        "title": "Pi: Open in New Window",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-agent-studio.openInFolder",
        "title": "Pi: Open Here",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-agent-studio.generateGitCommitMessage",
        "title": "Generate Commit Message with Pi",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-agent-studio.abortGitCommitMessage",
        "title": "Generate Commit Message with Pi - Stop",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pi-agent-studio.open",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "pi-agent-studio.openInFolder",
          "group": "navigation@99",
          "when": "explorerResourceIsFolder"
        }
      ],
      "scm/title": [
        {
          "command": "pi-agent-studio.generateGitCommitMessage",
          "group": "navigation",
          "when": "config.git.enabled && scmProvider == git && !pi-agent-studio.isGeneratingCommit"
        },
        {
          "command": "pi-agent-studio.abortGitCommitMessage",
          "group": "navigation",
          "when": "config.git.enabled && scmProvider == git && pi-agent-studio.isGeneratingCommit"
        }
      ],
      "commandPalette": [
        {
          "command": "pi-agent-studio.generateGitCommitMessage",
          "when": "config.git.enabled && !pi-agent-studio.isGeneratingCommit"
        },
        {
          "command": "pi-agent-studio.abortGitCommitMessage",
          "when": "config.git.enabled && pi-agent-studio.isGeneratingCommit"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi",
          "title": "Pi",
          "icon": "assets/logo.svg"
        }
      ]
    },
    "views": {
      "pi": [
        {
          "type": "webview",
          "id": "pi-agent-studio.sessions",
          "name": "Sessions"
        },
        {
          "type": "webview",
          "id": "pi-agent-studio.models",
          "name": "Models"
        },
        {
          "type": "webview",
          "id": "pi-agent-studio.agents",
          "name": "Agents"
        },
        {
          "type": "webview",
          "id": "pi-agent-studio.prompts",
          "name": "Prompt Templates"
        },
        {
          "type": "webview",
          "id": "pi-agent-studio.settings",
          "name": "Settings",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Pi",
      "properties": {
        "pi-agent-studio.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the pi binary. Leave empty for auto-detection."
        },
        "pi-agent-studio.env": {
          "type": "object",
          "default": {},
          "description": "Environment variables to set in the pi terminal session."
        },
        "pi-agent-studio.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra command-line arguments passed to pi."
        },
        "pi-agent-studio.commitLanguage": {
          "type": "string",
          "default": "English",
          "enum": [
            "English",
            "French",
            "Italian",
            "German",
            "Spanish",
            "Russian",
            "Chinese (Simplified)",
            "Chinese (Traditional)",
            "Japanese",
            "Korean",
            "Czech",
            "Portuguese (Brazil)",
            "Turkish",
            "Polish"
          ],
          "description": "Language for generated Git commit messages. Default is English."
        },
        "pi-agent-studio.commitMessagePrompt": {
          "type": "string",
          "default": "",
          "description": "Custom system prompt for commit message generation. If not provided, uses the default prompt."
        },
        "pi-agent-studio.commitModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[^/]+/.+$",
          "patternErrorMessage": "Format must be \"provider/model\", e.g. \"Zai/glm-5.2\".",
          "description": "Model used to generate Git commit messages, in \"provider/model\" format (e.g. \"Zai/glm-5.2\")."
        },
        "pi-agent-studio.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show live VS Code context (active editor, selection, diagnostics) in the pi TUI footer. Disable to stop the bundled bridge from updating the footer."
        },
        "pi-agent-studio.ui": {
          "type": "string",
          "enum": [
            "terminal",
            "webview"
          ],
          "default": "terminal",
          "enumDescriptions": [
            "Launch the pi TUI in an integrated terminal (default).",
            "Open a webview chat panel backed by a `pi --mode rpc` subprocess."
          ],
          "description": "Interface for the Pi: Open command. \"webview\" uses a chat panel instead of a terminal."
        },
        "pi-agent-studio.disabledTools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vscode_get_diagnostics",
              "todo",
              "questionnaire",
              "subagent"
            ]
          },
          "default": [],
          "description": "LLM tools registered by bundled extensions to disable (blocklist). Defaults to none (all enabled)."
        },
        "pi-agent-studio.permission.mode": {
          "type": "string",
          "enum": [
            "AskForApproval",
            "FullAccess"
          ],
          "default": "AskForApproval",
          "enumDescriptions": [
            "Prompt before running bash commands that match permission.dangerousPatterns.",
            "No gating — all bash commands run without confirmation."
          ],
          "description": "Permission mode for dangerous bash commands. AskForApproval prompts before matched commands run; FullAccess disables gating."
        },
        "pi-agent-studio.permission.dangerousPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\\brm\\s+(-rf?|--recursive)",
            "\\bsudo\\b",
            "\\b(chmod|chown)\\b.*777"
          ],
          "description": "Case-insensitive regexes marking a bash command as dangerous (requires approval in AskForApproval mode). User config fully replaces the defaults; an empty array gates nothing."
        },
        "pi-agent-studio.rpcTrace": {
          "type": "boolean",
          "default": false,
          "description": "Log all RPC traffic (requests, responses, events) and pi stderr to the \"Pi Chat RPC\" Output channel for debugging. Each webview panel is tagged by its panel id prefix."
        },
        "pi-agent-studio.chatFontSize": {
          "type": "number",
          "default": 13,
          "minimum": 8,
          "maximum": 32,
          "description": "Font size for the webview chat panel. Reopen the panel to apply changes."
        }
      }
    },
    "keybindings": [
      {
        "command": "pi-agent-studio.open",
        "key": "alt+shift+p"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "assets/icon.png",
  "badges": [
    {
      "url": "https://img.shields.io/github/stars/JohnnyZ93/pi-agent-studio?style=social",
      "description": "Star pi-agent-studio on Github",
      "href": "https://github.com/JohnnyZ93/pi-agent-studio"
    }
  ],
  "engines": {
    "vscode": "^1.110.0"
  },
  "packageManager": "pnpm@10.32.1"
}

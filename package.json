{
  "name": "pi-agent-studio",
  "displayName": "Pi Agent Studio",
  "version": "1.3.2",
  "description": "Feature-rich Pi coding agent for VS Code - native terminal TUI or webview chat panel, full editor bridge, and bundled pi extensions (todo, subagent...) out of the box, plus a sidebar to manage sessions, models, agents, and settings.",
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "agent",
    "ai",
    "ai-assistant",
    "anthropic",
    "chat",
    "claude",
    "coding-agent",
    "gemini",
    "llm",
    "openai",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "terminal",
    "tui"
  ],
  "bugs": {
    "url": "https://github.com/JohnnyZ93/pi-agent-studio/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnnyZ93/pi-agent-studio"
  },
  "publisher": "johnny-zhao",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "pnpm --filter pi-chat build && pnpm --filter pi-mcp build && pnpm --filter pi-settings build && rolldown -c rolldown.config.ts",
    "dev": "rolldown -c rolldown.config.ts -w",
    "package": "pnpm build && pnpx @vscode/vsce package --no-dependencies",
    "install-local": "pnpm package && code --install-extension *.vsix",
    "release": "node scripts/release.ts",
    "fmt": "oxlint . --fix && oxfmt .",
    "lint": "oxlint . && oxfmt --check .",
    "typecheck": "tsgo --noEmit --skipLibCheck",
    "test": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "1.100.0",
    "@typescript/native-preview": "^7.0.0-dev.20260320.1",
    "@vscode/vsce": "^3.7.1",
    "jsdom": "^30.0.1",
    "ovsx": "^0.10.9",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "rolldown": "^1.0.0-rc.10",
    "vitest": "^4.1.0"
  },
  "l10n": "./l10n",
  "contributes": {
    "icons": {
      "pi-logo": {
        "description": "%pi.icon.piLogo.desc%",
        "default": {
          "fontPath": "assets/fonts/pi-icons.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "commands": [
      {
        "command": "pi-agent-studio.open",
        "title": "%pi.cmd.open%",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-agent-studio.upgrade",
        "title": "%pi.cmd.upgrade%"
      },
      {
        "command": "pi-agent-studio.openSettingsJson",
        "title": "%pi.cmd.openSettingsJson%"
      },
      {
        "command": "pi-agent-studio.openModelsJson",
        "title": "%pi.cmd.openModelsJson%"
      },
      {
        "command": "pi-agent-studio.openSettings",
        "title": "%pi.cmd.openSettings%",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-agent-studio.openInNewWindow",
        "title": "%pi.cmd.openInNewWindow%",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-agent-studio.openInFolder",
        "title": "%pi.cmd.openInFolder%",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-agent-studio.generateGitCommitMessage",
        "title": "%pi.cmd.generateGitCommitMessage%",
        "icon": {
          "light": "assets/logo-light.svg",
          "dark": "assets/logo.svg"
        }
      },
      {
        "command": "pi-agent-studio.abortGitCommitMessage",
        "title": "%pi.cmd.abortGitCommitMessage%",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pi-agent-studio.open",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "pi-agent-studio.openInFolder",
          "group": "navigation@99",
          "when": "explorerResourceIsFolder"
        }
      ],
      "scm/title": [
        {
          "command": "pi-agent-studio.generateGitCommitMessage",
          "group": "navigation",
          "when": "config.git.enabled && scmProvider == git && !pi-agent-studio.isGeneratingCommit"
        },
        {
          "command": "pi-agent-studio.abortGitCommitMessage",
          "group": "navigation",
          "when": "config.git.enabled && scmProvider == git && pi-agent-studio.isGeneratingCommit"
        }
      ],
      "commandPalette": [
        {
          "command": "pi-agent-studio.generateGitCommitMessage",
          "when": "config.git.enabled && !pi-agent-studio.isGeneratingCommit"
        },
        {
          "command": "pi-agent-studio.abortGitCommitMessage",
          "when": "config.git.enabled && pi-agent-studio.isGeneratingCommit"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pi",
          "title": "%pi.activitybar.title%",
          "icon": "assets/logo.svg"
        }
      ]
    },
    "views": {
      "pi": [
        {
          "type": "webview",
          "id": "pi-agent-studio.sessions",
          "name": "%pi.view.sessions%"
        },
        {
          "type": "webview",
          "id": "pi-agent-studio.settings",
          "name": "%pi.view.settings%"
        }
      ]
    },
    "configuration": {
      "title": "%pi.config.title%",
      "properties": {
        "pi-agent-studio.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "zh-cn"
          ],
          "enumDescriptions": [
            "%pi.config.language.enumDesc.auto%",
            "%pi.config.language.enumDesc.en%",
            "%pi.config.language.enumDesc.zhcn%"
          ],
          "description": "%pi.config.language.desc%"
        },
        "pi-agent-studio.path": {
          "type": "string",
          "default": "",
          "description": "%pi.config.path.desc%"
        },
        "pi-agent-studio.bridgeSocket": {
          "type": "string",
          "default": "",
          "description": "%pi.config.bridgeSocket.desc%"
        },
        "pi-agent-studio.env": {
          "type": "object",
          "default": {},
          "description": "%pi.config.env.desc%"
        },
        "pi-agent-studio.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%pi.config.args.desc%"
        },
        "pi-agent-studio.commitLanguage": {
          "type": "string",
          "default": "English",
          "enum": [
            "English",
            "French",
            "Italian",
            "German",
            "Spanish",
            "Russian",
            "Chinese (Simplified)",
            "Chinese (Traditional)",
            "Japanese",
            "Korean",
            "Czech",
            "Portuguese (Brazil)",
            "Turkish",
            "Polish"
          ],
          "description": "%pi.config.commitLanguage.desc%"
        },
        "pi-agent-studio.commitMessagePrompt": {
          "type": "string",
          "default": "",
          "description": "%pi.config.commitMessagePrompt.desc%"
        },
        "pi-agent-studio.commitModel": {
          "type": "string",
          "default": "",
          "pattern": "^$|^[^/]+/.+$",
          "patternErrorMessage": "%pi.config.commitModel.patternError%",
          "description": "%pi.config.commitModel.desc%"
        },
        "pi-agent-studio.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%pi.config.statusBar.desc%"
        },
        "pi-agent-studio.ui": {
          "type": "string",
          "enum": [
            "terminal",
            "webview"
          ],
          "default": "terminal",
          "enumDescriptions": [
            "%pi.config.ui.enumDesc.0%",
            "%pi.config.ui.enumDesc.1%"
          ],
          "description": "%pi.config.ui.desc%"
        },
        "pi-agent-studio.disabledTools": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vscode_get_diagnostics",
              "todo",
              "questionnaire",
              "subagent"
            ]
          },
          "default": [],
          "description": "%pi.config.disabledTools.desc%"
        },
        "pi-agent-studio.mcp.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%pi.config.mcp.enabled.desc%"
        },
        "pi-agent-studio.mcp.idleTimeout": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "%pi.config.mcp.idleTimeout.desc%"
        },
        "pi-agent-studio.permission.mode": {
          "type": "string",
          "enum": [
            "AskForApproval",
            "FullAccess"
          ],
          "default": "AskForApproval",
          "enumDescriptions": [
            "%pi.config.permission.mode.enumDesc.0%",
            "%pi.config.permission.mode.enumDesc.1%"
          ],
          "description": "%pi.config.permission.mode.desc%"
        },
        "pi-agent-studio.permission.dangerousPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\\brm\\s+(?:-[rR][fF]?|-[fF][rR]|--recursive)\\b",
            "\\b(?:ri|rm|remove-item)\\b.*\\s+-(?:recurse|force)\\b",
            "\\b(?:rd|rmdir|del|erase)\\b.*\\s+[/-][a-z]*s[a-z]*\\b",
            "\\bshred\\b",
            "\\bdd\\b",
            "\\b(?:format\\s+[a-z]:|format-volume\\b|clear-disk\\b|diskpart\\b)",
            "\\bvssadmin\\s+delete\\s+shadows\\b",
            "\\b(?:chmod|chown)\\b.*\\s0?777\\b",
            "\\b(?:reg\\s+delete\\b|remove-item\\s+(?:hklm|hkcr|hku):)",
            "\\b(?:Set-ItemProperty|sp)\\b",
            "\\bSet-Acl\\b",
            "\\bdrop\\s+(database|table|schema)\\b",
            "\\btruncate\\s+table\\b",
            "\\b(flushall|flushdb)\\b",
            "\\b(?:restart-computer|stop-computer)\\b",
            "\\b(?:taskkill(?:\\.exe)?\\s+/f|spps|stop-process)\\b",
            "\\b(killall|pkill)\\b",
            "\\bkill\\s+-9\\b",
            "\\bsc\\s+delete\\b",
            "\\bbcdedit\\s+(?:/delete|/set)\\b",
            ":\\(\\)\\s*\\{",
            "\\bsudo\\b",
            "\\b(curl|wget)\\s+.*\\|\\s*(ba)?sh\\b",
            "(?:\\bsource\\s+<\\(|\\.\\s+<\\()",
            "(?:\\binvoke-expression\\b|\\biex\\s*\\(|\\|\\s*iex\\b)",
            "\\b(?:Invoke-(?:RestMethod|WebRequest)|irm|iwr)\\b",
            "\\beval\\b",
            "\\b(git\\s+push\\s+(--force|-f))\\b",
            "\\bgit\\s+branch\\b.*\\s+-(?:d|D|m|M|-delete|-force)\\b",
            "\\bgit\\s+log\\b.*--output\\b",
            "\\bfind\\b.*\\s+-(?:delete|exec|execdir|fprint|fprintf|fls|ok|okdir)\\b",
            "\\brg\\b.*\\s+--(?:pre|hostname-bin)\\b",
            "\\bsed\\b.*\\s+-(?:[a-zA-Z]*[ef][a-zA-Z]*|expression|file)\\b",
            "\\bsed\\b(?:\\s+-[a-zA-Z]+)*\\s+[\"']s\\/[^/\"]*\\/[^/\"]*\\/[a-zA-Z]*[ew]",
            "\\bsed\\b(?:\\s+-[a-zA-Z]+)*\\s+[\"'][^\"']*;W",
            "\\bsort\\b.*\\s+-(?:o|S)\\b",
            "\\btree\\b.*\\s+-o\\b",
            "\\bcolumn\\b.*\\s+-c\\s+\\d+",
            "\\bdate\\b.*\\s+(?:-s|--set)\\b"
          ],
          "description": "%pi.config.permission.dangerousPatterns.desc%"
        },
        "pi-agent-studio.rpcTrace": {
          "type": "boolean",
          "default": false,
          "description": "%pi.config.rpcTrace.desc%"
        },
        "pi-agent-studio.chatFontSize": {
          "type": "number",
          "default": 13,
          "minimum": 8,
          "maximum": 32,
          "description": "%pi.config.chatFontSize.desc%"
        },
        "pi-agent-studio.chatMermaidTheme": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "neutral",
            "dark",
            "forest",
            "base"
          ],
          "enumDescriptions": [
            "%pi.config.chatMermaidTheme.default%",
            "%pi.config.chatMermaidTheme.neutral%",
            "%pi.config.chatMermaidTheme.dark%",
            "%pi.config.chatMermaidTheme.forest%",
            "%pi.config.chatMermaidTheme.base%"
          ],
          "description": "%pi.config.chatMermaidTheme.desc%"
        }
      }
    },
    "keybindings": [
      {
        "command": "pi-agent-studio.open",
        "key": "alt+shift+p"
      },
      {
        "command": "pi-agent-studio.openSettings",
        "key": "alt+shift+,"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "assets/icon.png",
  "badges": [
    {
      "url": "https://img.shields.io/github/stars/JohnnyZ93/pi-agent-studio?style=social",
      "description": "%pi.badge.stars.desc%",
      "href": "https://github.com/JohnnyZ93/pi-agent-studio"
    }
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@10.32.1"
}
